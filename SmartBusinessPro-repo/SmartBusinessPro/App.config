<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Ajuste Server segun su equipo. LocalDB: (localdb)\MSSQLLocalDB -->
    <add name="SmartBusinessConnection"
         connectionString="Server=localhost\SQLEXPRESS;Database=SmartBusinessPro;Trusted_Connection=True;TrustServerCertificate=True;Connect Timeout=15;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
